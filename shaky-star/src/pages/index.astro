---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="GDG Productions | Sites web sur mesure à Montréal"
	description="Studio web montréalais : sites vitrines, portfolios et design sur mesure pour les petites entreprises et les entrepreneurs. Du brut au remarquable."
	path="/"
>
	<section class="hero">
		<div class="wrap hero-grid">
			<div>
				<p class="eyebrow">Studio web indépendant · Montréal</p>
				<h1>Votre entreprise mérite <em>sa place au premier plan.</em></h1>
				<p class="hero-lead">Des sites web sur mesure qui font ressortir ce qui vous rend unique, et donnent envie de vous choisir.</p>
				<div class="hero-actions">
					<a class="btn btn-gold" href="/contact">Parlons de votre projet <span aria-hidden="true">↗</span></a>
					<a class="btn btn-ghost" href="/services">Découvrir nos services</a>
				</div>
				<p class="hero-note">Pour les petites entreprises et les entrepreneurs qui voient grand.</p>
			</div>
			<div class="collage">
				<div class="collage-arch">
					<img src="/img/pierre-brute.webp" alt="Une pierre brute dont une facette polie rayonne, au milieu de rubans aux motifs géométriques." width="2200" height="1228" fetchpriority="high" />
				</div>
				<div class="collage-orb">
					<img src="/img/atelier-outils.webp" alt="" width="2200" height="1228" loading="lazy" />
				</div>
				<p class="collage-tag" aria-hidden="true">Du brut au remarquable.</p>
				<img class="logo-circle collage-seal" src="/logogdgproductions.jpg" alt="Logo GDG Productions" width="144" height="144" />
			</div>
		</div>
	</section>

	<div class="ribbon" aria-label="Nos spécialités">
		<ul>
			<li>Sites vitrines</li>
			<li>Portfolios</li>
			<li>Design sur mesure</li>
			<li>Référencement naturel</li>
		</ul>
	</div>

	<section class="section on-light">
		<div class="wrap">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Ce qu'on crée</p>
				<h2>Un bon site ne fait pas que paraître. Il vous fait reconnaître.</h2>
				<p>Votre site est souvent le premier contact avec un futur client. Faisons-en une première impression qui vous ressemble.</p>
			</div>
			<div class="offer-grid">
				<a class="offer" href="/services#vitrine" data-reveal>
					<img class="offer-img" src="/img/porte-vitrine.webp" alt="" width="1500" height="1120" loading="lazy" /><span class="offer-no" aria-hidden="true">01</span>
					<h3>Site vitrine</h3>
					<p>Présentez clairement vos services, votre histoire et la façon de vous joindre, avec un site pensé pour votre clientèle.</p>
					<span class="offer-more">En savoir plus ↗</span>
				</a>
				<a class="offer" href="/services#portfolio" data-reveal style="--d: .12s">
					<img class="offer-img" src="/img/galerie.webp" alt="" width="1500" height="2000" loading="lazy" /><span class="offer-no" aria-hidden="true">02</span>
					<h3>Portfolio</h3>
					<p>Donnez à vos créations et à votre expertise l'espace qu'elles méritent pour convaincre au premier regard.</p>
					<span class="offer-more">En savoir plus ↗</span>
				</a>
				<a class="offer" href="/services#design" data-reveal style="--d: .24s">
					<img class="offer-img" src="/img/table-design.webp" alt="" width="2200" height="2200" loading="lazy" /><span class="offer-no" aria-hidden="true">03</span>
					<h3>Design & développement</h3>
					<p>Une interface sur mesure, adaptée aux mobiles et développée avec les technologies web actuelles.</p>
					<span class="offer-more">En savoir plus ↗</span>
				</a>
			</div>
		</div>
	</section>

	<section id="atelier" class="section on-green cut-r">
		<div class="wrap atelier-grid">
			<div class="atelier-copy" data-reveal>
				<p class="eyebrow">Notre savoir-faire</p>
				<h2>Votre différence mérite mieux qu'un modèle tout fait.</h2>
				<p>Un aperçu conceptuel pour illustrer comment le design d'un site s'adapte à l'histoire de chaque entreprise. Choisissez un univers.</p>
				<div class="demo-switcher" role="group" aria-label="Choisir un exemple de direction créative">
					<button type="button" class="demo-choice is-active" aria-pressed="true" data-demo="business">Petite entreprise</button>
					<button type="button" class="demo-choice" aria-pressed="false" data-demo="entrepreneur">Entrepreneur</button>
					<button type="button" class="demo-choice" aria-pressed="false" data-demo="portfolio">Portfolio</button>
				</div>
				<p class="demo-disclaimer">Une démonstration de design, pas un mandat réalisé.</p>
			</div>
			<div class="demo-stage" data-reveal style="--d: .15s">
				<div class="demo-frame">
					<div class="demo-bar">
						<span class="demo-dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<span>aperçu de direction créative</span>
					</div>
					<div class="demo-screen">
						<img class="is-active" data-demo-img="business" src="/img/porte-vitrine.webp" alt="" width="1500" height="1120" loading="lazy" />
						<img data-demo-img="entrepreneur" src="/img/constellation.webp" alt="" width="2200" height="1228" loading="lazy" />
						<img data-demo-img="portfolio" src="/img/chemin.webp" alt="" width="2200" height="1228" loading="lazy" />
						<div class="demo-overlay" aria-live="polite">
							<div class="demo-nav"><span id="demo-brand">ATELIER LOCAL</span><span aria-hidden="true">↗</span></div>
							<div class="demo-body">
								<p class="demo-label" id="demo-label">FAIT AVEC INTENTION · MONTRÉAL</p>
								<h3 class="demo-title" id="demo-title">Le travail bien fait se voit.</h3>
								<p class="demo-text" id="demo-description">Des pièces conçues ici, façonnées pour accompagner votre quotidien.</p>
								<span class="demo-action" id="demo-action">Découvrir l'atelier ↗</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section on-light cut-l">
		<div class="wrap">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Notre approche</p>
				<h2>De la première idée au site dont vous êtes fier.</h2>
				<p>Un processus clair, des échanges directs et un résultat façonné autour de votre entreprise.</p>
			</div>
			<div class="steps">
				<article class="step" data-reveal><div class="step-art"><img src="/img/etape-1.webp" alt="" width="1000" height="1329" loading="lazy" /><span class="step-no" aria-hidden="true">01</span></div><h3>On vous écoute.</h3><p>Vos objectifs, vos clients, ce qui rend votre activité différente : on commence par comprendre votre réalité.</p></article>
				<article class="step" data-reveal style="--d: .12s"><div class="step-art"><img src="/img/etape-2.webp" alt="" width="1000" height="1329" loading="lazy" /><span class="step-no" aria-hidden="true">02</span></div><h3>On donne forme à l'idée.</h3><p>Ensemble, nous définissons le bon contenu et un design sur mesure, avant de passer au développement.</p></article>
				<article class="step" data-reveal style="--d: .24s"><div class="step-art"><img src="/img/etape-3.webp" alt="" width="1000" height="1329" loading="lazy" /><span class="step-no" aria-hidden="true">03</span></div><h3>On révèle votre site.</h3><p>On peaufine les détails, on vérifie l'expérience sur mobile et on prépare votre nouvelle présence en ligne.</p></article>
			</div>
		</div>
	</section>

	<section class="section on-green persona cut-l">
		<div class="wrap">
			<div class="section-head" data-reveal>
				<p class="eyebrow">Pour qui on crée</p>
				<h2>Un site à l'image de votre univers.</h2>
				<p>Artisans, entrepreneurs, créatifs : chaque histoire mérite sa propre forme.</p>
			</div>
			<div class="persona-grid">
				<article class="persona" data-reveal><div class="persona-art"><img src="/img/artisan.webp" alt="Un établi d'artisan avec outils, tissus et lanterne, un diamant posé sur la table." width="1400" height="1875" loading="lazy" /></div><h3>L'artisan</h3><p>Montrez le geste, la matière et le soin qui font la valeur de votre savoir-faire.</p></article>
				<article class="persona" data-reveal style="--d: .12s"><div class="persona-art"><img src="/img/entrepreneur.webp" alt="Un escalier de papier montant vers un cristal lumineux, entouré de rubans." width="1400" height="1875" loading="lazy" /></div><h3>L'entrepreneur</h3><p>Posez une première marche solide : un site clair qui inspire confiance dès le départ.</p></article>
				<article class="persona" data-reveal style="--d: .24s"><div class="persona-art"><img src="/img/createur.webp" alt="Un carnet ouvert d'où s'échappent des rubans de couleur, avec un prisme et des pinceaux." width="1400" height="1897" loading="lazy" /></div><h3>Le créatif</h3><p>Offrez à vos œuvres un espace éditorial qui leur ressemble.</p></article>
			</div>
		</div>
	</section>

	<section class="section story on-dark cut-r" data-depth>
		<div class="depth-mid" aria-hidden="true"><img src="/img/rubans.webp" alt="" width="1600" height="900" loading="lazy" /></div>
		<div class="wrap story-grid">
			<div data-reveal>
				<p class="eyebrow">Notre histoire</p>
				<h2>Du charbon au diamant.</h2>
				<p>Sous la pression et le temps, le charbon devient diamant. C'est la même transformation que nous cherchons pour chaque projet : partir de votre idée brute et en révéler tout l'éclat.</p>
				<a class="btn btn-gold" href="/about">Découvrir GDG Productions <span aria-hidden="true">↗</span></a>
			</div>
			<div class="story-depth" data-reveal style="--d: .15s">
				<span class="depth-ring" aria-hidden="true"></span>
				<div class="story-circle">
					<img src="/img/pierre-gouache.webp" alt="Une pierre brute translucide qui capte la lumière." width="2200" height="1228" loading="lazy" />
				</div>
				<img class="depth-gem" src="/img/atelier-outils.webp" alt="" width="400" height="400" loading="lazy" />
			</div>
		</div>
	</section>

	<section class="section cta cta-art cut-l">
		<div class="wrap" data-reveal>
			<p class="eyebrow">Le prochain diamant, c'est peut-être le vôtre.</p>
			<h2>Parlons de votre projet.</h2>
			<p>Pas besoin d'avoir tout planifié. Racontez-nous où vous voulez aller, on verra ensemble comment y arriver.</p>
			<a class="btn btn-gold" href="/contact">Commencer la conversation <span aria-hidden="true">↗</span></a>
		</div>
	</section>

	<script is:inline>
	(function () {
		var depth = document.querySelector("[data-depth]");
		if (depth && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			var ticking = false;
			var update = function () {
				var r = depth.getBoundingClientRect();
				var p = (r.top + r.height / 2 - innerHeight / 2) / (innerHeight / 2 + r.height / 2);
				depth.style.setProperty("--p", Math.max(-1, Math.min(1, p)).toFixed(3));
				ticking = false;
			};
			update();
			addEventListener("scroll", function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
		}
		var examples = {
			business: { brand: 'ATELIER LOCAL', label: 'FAIT AVEC INTENTION · MONTRÉAL', title: 'Le travail bien fait se voit.', description: 'Des pièces conçues ici, façonnées pour accompagner votre quotidien.', action: 'Découvrir l\u2019atelier \u2197' },
			entrepreneur: { brand: 'MAISON DEMAIN', label: 'UNE IDÉE, UNE SIGNATURE', title: 'Faire mieux commence ici.', description: 'Une vision claire, racontée avec le caractère qui la rend vôtre.', action: 'Découvrir notre approche \u2197' },
			portfolio: { brand: 'STUDIO CRÉATIF', label: 'SÉLECTION · PORTFOLIO', title: 'Chaque image a son histoire.', description: 'Un espace éditorial pour mettre votre travail et votre regard en valeur.', action: 'Explorer les projets \u2197' }
		};
		var fields = { brand: 'demo-brand', label: 'demo-label', title: 'demo-title', description: 'demo-description', action: 'demo-action' };
		var buttons = document.querySelectorAll('.demo-choice');
		buttons.forEach(function (button) {
			button.addEventListener('click', function () {
				var key = button.dataset.demo;
				var example = examples[key];
				if (!example) return;
				buttons.forEach(function (b) {
					var active = b === button;
					b.classList.toggle('is-active', active);
					b.setAttribute('aria-pressed', String(active));
				});
				document.querySelectorAll('[data-demo-img]').forEach(function (img) {
					img.classList.toggle('is-active', img.dataset.demoImg === key);
				});
				Object.keys(fields).forEach(function (f) {
					document.getElementById(fields[f]).textContent = example[f];
				});
			});
		});
	})();
	</script>
</Layout>
